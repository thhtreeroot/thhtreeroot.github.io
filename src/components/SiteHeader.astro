---
import { b } from '../utils/base';
const { pathname } = Astro.url;
const links = [
  { href: b('/'), label: '首页' },
  { href: b('/blog'), label: '文章' },
  { href: b('/tags'), label: '标签' },
  { href: b('/about'), label: '关于' },
];
---
<header class="bar">
  <a class="logo" href={b('/')}>拾遗集</a>
  <nav aria-label="主导航">
    {links.map((l) => (
      <a href={l.href} class:list={{ active: pathname === l.href }}>{l.label}</a>
    ))}
  </nav>
</header>
