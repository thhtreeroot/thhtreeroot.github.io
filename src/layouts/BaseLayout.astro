---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
}
const { title, description = '拾遗集：人类的悲欢并不相通，我只觉得他们吵闹。—— 一个 CTF 与计算机学习的博客。' } = Astro.props;
const assetBase = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${assetBase}favicon.svg`} />
    <ClientRouter />
    <script is:inline>
      // 动效开关：加在 <html> 上，所有"先隐藏再浮现"的样式都挂在 .js 之下，
      // 没有 JS 时内容一律直接可见。若主脚本 1.8s 内没能接管（脚本被拦/加载失败），
      // 自动摘掉开关，保证内容不会因为动效脚本没跑起来而一直隐形。
      document.documentElement.classList.add('js');
      setTimeout(function () {
        if (!document.documentElement.hasAttribute('data-anim-ready')) {
          document.documentElement.classList.remove('js');
        }
      }, 1800);
    </script>
  </head>
  <body>
    <div class="bg" style={`--bg-image:url('${assetBase}bg.jpg')`} aria-hidden="true"></div>
    <div class="bg-veil" aria-hidden="true"></div>
    <div class="progress" id="progress" aria-hidden="true"></div>
    <div class="page">
      <SiteHeader />
      <main>
        <slot />
      </main>
      <SiteFooter />
    </div>
    <script>
      // 所有页面动效在这里统一初始化。astro:page-load 在首次加载和每次视图过渡
      // 完成后都会触发，因此 ClientRouter 换页后动效依然生效。
      function initPage() {
        // 再补一次保险：动效开关必须始终在 <html> 上
        document.documentElement.classList.add('js');
        document.documentElement.setAttribute('data-anim-ready', '1');

        // 1) 滚动浮现：进入视口的 .reveal 元素加 .in（只改透明度，不做位移）
        const reveals = Array.from(document.querySelectorAll('.reveal'));
        const show = (el) => el.classList.add('in');
        // 几何兜底：只判断元素是否进入视口，不看"可见比例"。
        // 长文章整体就是一个 .reveal，用比例阈值（如 0.15）在视口偏小时永远达不到，
        // 会导致正文永久不可见，所以这里必须用不带比例的方式。
        const inView = (el) => {
          const r = el.getBoundingClientRect();
          return r.top < innerHeight * 0.94 && r.bottom > 0;
        };
        const sweep = () => {
          for (const el of reveals) {
            if (!el.classList.contains('in') && inView(el)) show(el);
          }
        };

        if ('IntersectionObserver' in window) {
          const io = new IntersectionObserver(
            (entries) => {
              for (const e of entries) {
                if (e.isIntersecting) {
                  show(e.target);
                  io.unobserve(e.target);
                }
              }
            },
            { threshold: 0, rootMargin: '0px 0px -6% 0px' }
          );
          reveals.forEach((el) => io.observe(el));
        }

        // 无论上面是否生效，load/滚动/缩放时都再兜一次，保证内容一定会出现
        sweep();
        addEventListener('load', () => { sweep(); requestAnimationFrame(sweep); });
        addEventListener('scroll', sweep, { passive: true });
        addEventListener('resize', sweep);

        // 2) 首页：标题层与内容层钉住不动；越过阈值后锁定状态，用 0.5s 淡入淡出切换
        const heroLayer = document.getElementById('hero-layer');
        const postsLayer = document.getElementById('posts-layer');
        const stage = document.querySelector('.stage');
        const animOn = document.documentElement.classList.contains('js');
        if (heroLayer && postsLayer && stage && animOn && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          // 舞台高度 = 内容层高度 + 0.75 屏。内容比一屏高时（手机）也保证两层都能钉住：
          // 交叉淡化在钉住期间完成，画面不动；之后恢复普通滚动。
          const sizeStage = () => {
            stage.style.height = `${Math.round(postsLayer.offsetHeight + innerHeight * 0.75)}px`;
          };

          // 进度 p = 滚动量 / 交叉淡化行程（0.62 屏）。
          // 回滞阈值：p ≥ 0.65 锁定为内容态；p ≤ 0.35 锁定回标题态；
          // 35%~65% 之间保持现状（避免在两个状态之间来回抖）。
          const BAND = 0.62;
          const DOWN = 0.65;
          const UP = 0.35;
          const TWEEN = 500; // 与 CSS 中 .layer 的过渡时长一致（ms）
          let state = 'title';
          let locked = false;
          let timer = 0;

          const applyState = (next) => {
            if (next === state) return;
            state = next;
            locked = true; // 过渡期间锁定：滚动不会打断这次切换
            clearTimeout(timer);
            timer = setTimeout(() => { locked = false; }, TWEEN);
            const content = next === 'content';
            heroLayer.style.opacity = content ? '0' : '1';
            postsLayer.style.opacity = content ? '1' : '0';
            // 显式写 auto/none：CSS 里 posts-layer 默认 pointer-events:none，
            // 只清空内联样式会回落到 none，内容态的卡片就点不动了
            postsLayer.style.pointerEvents = content ? 'auto' : 'none';
            if ('inert' in HTMLElement.prototype) {
              postsLayer.inert = !content;
              heroLayer.inert = content;
            }
          };

          const onScroll = () => {
            if (locked) return;
            const p = scrollY / (innerHeight * BAND);
            if (p >= DOWN) applyState('content');
            else if (p <= UP) applyState('title');
          };

          // 初始标题态：内容层不可交互，也不会被读屏器读到
          if ('inert' in HTMLElement.prototype) postsLayer.inert = true;
          addEventListener('scroll', onScroll, { passive: true });
          addEventListener('resize', () => { sizeStage(); locked = false; onScroll(); });
          addEventListener('load', sizeStage);
          sizeStage();
          onScroll();
        }

        // 3) 顶部阅读进度条
        const bar = document.getElementById('progress');
        if (bar) {
          const updateBar = () => {
            const d = document.documentElement;
            const max = d.scrollHeight - d.clientHeight;
            bar.style.width = max > 0 ? `${(d.scrollTop / max) * 100}%` : '0';
          };
          addEventListener('scroll', updateBar, { passive: true });
          updateBar();
        }
      }

      // ClientRouter 换页时会整体替换 <html>，运行时加上的 .js 类会被丢掉，
      // 导致换页后（比如从文章返回首页）所有动效样式失效、退化成普通排布。
      // astro:after-swap 在"新页面已换入、视图过渡渲染之前"触发，在这里补回来，
      // 既修好失效问题，也不会闪回无动效的排布。
      document.addEventListener('astro:after-swap', () => {
        document.documentElement.classList.add('js');
      });
      document.addEventListener('astro:page-load', initPage);
    </script>
  </body>
</html>
