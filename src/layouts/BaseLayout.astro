---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
}
const { title, description = '拾遗集：人类的悲欢并不相通，我只觉得他们吵闹。—— 一个 CTF 与计算机学习的博客。' } = Astro.props;
const assetBase = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${assetBase}favicon.svg`} />
  </head>
  <body>
    <div class="bg" style={`--bg-image:url('${assetBase}bg.jpg')`} aria-hidden="true"></div>
    <div class="bg-veil" aria-hidden="true"></div>
    <div class="progress" id="progress" aria-hidden="true"></div>
    <div class="page">
      <SiteHeader />
      <main>
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>

<script>
  // 滚动浮现：进入视口的 .reveal 元素加 .in（缓慢浮起）
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          e.target.classList.add('in');
          io.unobserve(e.target);
        }
      }
    },
    { threshold: 0.15, rootMargin: '0px 0px -8% 0px' }
  );
  document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

  // 顶部阅读进度条
  const bar = document.getElementById('progress');
  if (bar) {
    const update = () => {
      const d = document.documentElement;
      const max = d.scrollHeight - d.clientHeight;
      bar.style.width = max > 0 ? `${(d.scrollTop / max) * 100}%` : '0';
    };
    document.addEventListener('scroll', update, { passive: true });
    update();
  }
</script>
